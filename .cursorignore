# Virtual Environments (The biggest credit drains)
.venv/
venv/
env/
ENV/
.env/

# Python Cache & Compiled Files
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Local Data and Model Checkpoints (If doing AI/Data Science)
*.csv
*.xlsx
*.parquet
*.pkl
*.pickle
*.h5
*.pt
*.pth
*.onnx
dataset/
data/

# Generated outputs and local databases
*.pdf
payroll.db
*.db
*.sqlite3

# Binary assets (logos; not useful for code indexing)
Images/
app/assets/

# CRA XSD package (~1.2M) — keep T4 filing subset only; rest stays on disk for validation
# T4 Amended (A) and Cancel (C) are defined here (no separate XSDs):
#   simple.xsd (slipDataType), t4.xsd (rpt_tcd), t4_efile_preview.xsd (reportTypeCode)
# TODO: wire A/C report types in cra_efile_service (currently hardcoded to O)
schemas/cra/**
!schemas/cra/T619_T4.xsd
!schemas/cra/t4.xsd
!schemas/cra/t4_efile_preview.xsd
!schemas/cra/simple.xsd
!schemas/cra/complex.xsd
!schemas/cra/standarddatatypes.xsd
!schemas/cra/cracommonstructures.xsd

# RQ XSD package — keep Relevé 1 filing subset only; rest stays on disk for validation
# Original (R) only for now; Amended (A) and Cancel (D) deferred
schemas/rq/**
!schemas/rq/Transmission.xsd
!schemas/rq/P.xsd
!schemas/rq/Groupes.xsd
!schemas/rq/R01.xsd
!schemas/rq/T01.xsd
!schemas/rq/Simple.xsd
!schemas/rq/Complexe.xsd
!schemas/rq/SimpleEvolutif.xsd
!schemas/rq/releve1_efile_preview.xsd
!schemas/rq/read-me.txt
